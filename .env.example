# --- Data mode (src/config.py) ---
# "mock" (default): Competitor / Pricing / Supply Chain agents read only
# from the local SQLite mock database (data/mock.db, see src/mockdb/) and
# never call any adapter below. "real": use the tiered live-adapter logic
# as originally implemented.
DATA_MODE=mock
MOCK_DB_PATH=

# --- OpenStreetMap Overpass API: real, public, keyless. Safe default. ---
# OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
# OVERPASS_TIMEOUT_SECONDS=25

# --- Udyam Registration bulk dataset: NO PUBLIC LIVE API EXISTS. ---
# Point this at a bulk CSV extract you have downloaded/licensed yourself.
# Without this set, the Competitor Agent's Udyam tier returns
# INSUFFICIENT_DATA and falls back to the Overpass tier.
UDYAM_DATASET_PATH=

# --- Government commodity price API (data.gov.in / Agmarknet-style). ---
# The Technical Design Document names this source category but not a
# specific dataset. You must register for an API key and identify the
# resource id for the dataset you intend to use.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_BASE_URL=https://api.data.gov.in/resource
COMMODITY_PRICE_RESOURCE_ID=

# --- SECC purchasing-power proxy dataset: NO PUBLIC LIVE API EXISTS. ---
# Point this at a bulk SECC asset-data extract you have downloaded.
SECC_DATASET_PATH=

# --- Open-source routing engine (OSRM). ---
# Defaults to the public OSRM demo server if unset — NOT for production
# use (rate-limited, no uptime guarantee). Set this to your own
# self-hosted OSRM instance for production.
OSRM_BASE_URL=
