# Copy this file to config/.env and adjust as needed.
# All defaults below match the sample/fixture data shipped in data/ so the
# project runs out of the box for local development and testing.

# --- Geocoding (Market Reach Agent) ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires a real, identifying User-Agent (and asks
# that you not fake it) -- put a real contact address here before any use
# beyond local testing: https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_USER_AGENT=rural-advisory-agents-prototype/0.1 (contact: you@example.com)
NOMINATIM_MIN_INTERVAL_SECONDS=1.0
LGD_DATA_PATH=data/lgd/sample_lgd_codes.csv

# --- LGD live API (optional; NAPIX -- gated, approval-based, see
# data_connectors/geocoding.py docstring). Leave disabled to keep using
# LGD_DATA_PATH (the unconditionally-free path: download the real directory
# from lgdirectory.gov.in with no API/approval needed).
LGD_API_ENABLED=false
LGD_API_BASE_URL=https://dev.napix.gov.in/nic/lgd
LGD_API_KEY=

# --- Population (Market Reach Agent) ---
# SAMPLE fixture by default -- replace with real data via:
#   python -m data_connectors.census --build-index
# which needs the two settings blocks below filled in first.
CENSUS_DATA_PATH=data/census/sample_villages.csv

# data.gov.in API (free, self-serve -- sign up at data.gov.in, generate a
# key from your profile immediately, no approval wait).
DATA_GOV_IN_API_KEY=
# JSON object mapping a label (state/district, your choice) -> the
# data.gov.in resource_id for that Census 2011 Village/Town-wise Primary
# Census Abstract dataset. Find each resource_id on that dataset's own
# catalog page (look for the "API" / "Access API" tab).
CENSUS_RESOURCE_IDS={}
# Override these only after checking a real API response's field names.
CENSUS_API_VILLAGE_CODE_FIELD=village_code
CENSUS_API_VILLAGE_NAME_FIELD=village_name
CENSUS_API_DISTRICT_FIELD=district_name
CENSUS_API_STATE_FIELD=state_name
CENSUS_API_POPULATION_FIELD=tot_p

# SHRUG centroid file (manually downloaded from
# devdatalab.org/shrug_download -- no confirmed stable auto-download URL,
# see data_connectors/shrug.py). Provides the lat/lon that raw Census data
# lacks, joined on this village-id column.
SHRUG_KEYS_CSV_PATH=
SHRUG_ID_FIELD=pc11_village_id
SHRUG_LAT_FIELD=latitude
SHRUG_LON_FIELD=longitude

# --- Points of interest (Market Reach Agent, Opportunity Agent proxy) ---
OVERPASS_BASE_URL=https://overpass-api.de/api

# --- Market Reach Agent ---
MARKET_REACH_RADIUS_KM=10.0

# --- Opportunity Agent / RAG ---
VECTOR_STORE_PATH=data/vector_store
REFERENCE_CORPUS_PATH=data/reference_corpus
OPPORTUNITY_TOP_K=5
