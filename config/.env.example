# Copy this file to config/.env and adjust as needed.
# All defaults below match the sample/fixture data shipped in data/ so the
# project runs out of the box for local development and testing.

# --- Geocoding (Market Reach Agent) ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires a real, identifying User-Agent (and asks
# that you not fake it) -- put a real contact address here before any use
# beyond local testing: https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_USER_AGENT=rural-advisory-agents-prototype/0.1 (contact: you@example.com)
NOMINATIM_MIN_INTERVAL_SECONDS=1.0
LGD_DATA_PATH=data/lgd/sample_lgd_codes.csv

# --- Population (Market Reach Agent) ---
# SAMPLE fixture by default -- replace with the real Census 2011 village-level
# extract before any real use. See TECHNICAL_SETUP.md Section 8.2.
CENSUS_DATA_PATH=data/census/sample_villages.csv

# --- Points of interest (Market Reach Agent, Opportunity Agent proxy) ---
OVERPASS_BASE_URL=https://overpass-api.de/api

# --- Market Reach Agent ---
MARKET_REACH_RADIUS_KM=10.0

# --- Opportunity Agent / RAG ---
VECTOR_STORE_PATH=data/vector_store
REFERENCE_CORPUS_PATH=data/reference_corpus
OPPORTUNITY_TOP_K=5
