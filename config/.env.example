# Copy to config/.env (or .env at the repo root). Defaults run fully offline on the
# bundled SAMPLE fixtures; every figure derived from them is labeled "estimated".

# --- Runtime mode ---
# offline: never touch the network. live: call Nominatim / Overpass / data.gov.in with timeouts.
DATA_MODE=offline
HTTP_TIMEOUT_SECONDS=12

# --- Geocoding (data_connectors/geocoding.py) ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# OSM usage policy requires an identifying User-Agent with a real contact before live use;
# a warning is logged while the placeholder is present.
NOMINATIM_USER_AGENT=sih26091-advisory-prototype/0.2 (contact: set-your-email-here)
NOMINATIM_MIN_INTERVAL_SECONDS=1.0
# LGD code table (village_name, block, district, state, lgd_code[, is_sample]); download the
# real directory from lgdirectory.gov.in. Rows with is_sample=1 are treated as estimated.
LGD_DATA_PATH=data/lgd/sample_lgd_codes.csv

# --- Population (data_connectors/census.py) ---
# SAMPLE fixture by default; build a real table with `python -m data_connectors.census --build-index`
# (needs DATA_MODE=live, the data.gov.in key/resource ids and a SHRUG centroid file below).
CENSUS_DATA_PATH=data/census/sample_villages.csv
DATA_GOV_IN_API_KEY=
# JSON map of label -> data.gov.in resource_id of each state's Village/Town-wise Primary Census Abstract.
CENSUS_RESOURCE_IDS={}
CENSUS_API_VILLAGE_CODE_FIELD=village_code
CENSUS_API_VILLAGE_NAME_FIELD=village_name
CENSUS_API_DISTRICT_FIELD=district_name
CENSUS_API_STATE_FIELD=state_name
CENSUS_API_POPULATION_FIELD=tot_p
# SHRUG village centroid CSV, downloaded manually from devdatalab.org/shrug_download.
SHRUG_KEYS_CSV_PATH=
SHRUG_ID_FIELD=pc11_village_id
SHRUG_LAT_FIELD=latitude
SHRUG_LON_FIELD=longitude

# --- Points of interest (data_connectors/overpass.py) ---
OVERPASS_BASE_URL=https://overpass-api.de/api

# --- Market Reach / Opportunity agents ---
MARKET_REACH_RADIUS_KM=10.0
# Folder of <sector>__<activity_id>.md documents; validate with `python -m rag.ingest_sector_reports`.
REFERENCE_CORPUS_PATH=data/reference_corpus
OPPORTUNITY_TOP_K=5
